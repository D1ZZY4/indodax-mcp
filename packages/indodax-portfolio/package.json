{
  "name": "@indodax-mcp/indodax-portfolio",
  "version": "1.1.1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "biome lint .",
    "format:check": "biome format .",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "decimal.js": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "bun-types": "catalog:",
    "vitest": "catalog:"
  },
  "description": "Portfolio valuation, PnL, and drawdown calculations.",
  "keywords": [
    "indodax",
    "mcp",
    "model-context-protocol",
    "trading",
    "crypto"
  ],
  "homepage": "https://github.com/D1ZZY4/indodax-mcp#readme",
  "bugs": {
    "url": "https://github.com/D1ZZY4/indodax-mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/D1ZZY4/indodax-mcp.git"
  },
  "license": "SSPL-1.0",
  "author": "D1ZZY4",
  "publishConfig": {
    "access": "public"
  }
}
