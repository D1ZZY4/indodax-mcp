    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun ./src/migrate.ts"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "postgres": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "bun-types": "catalog:",
    "drizzle-kit": "catalog:",
    "embedded-postgres": "17.10.0-beta.17",
    "vitest": "catalog:"
  }
}
