{
  "name": "@indodax-mcp/indodax-mcp",
  "version": "1.1.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "biome lint .",
    "format:check": "biome format .",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@indodax-mcp/config": "workspace:*",
    "@indodax-mcp/core": "workspace:*",
    "@indodax-mcp/db": "workspace:*",
    "@indodax-mcp/errors": "workspace:*",
    "@indodax-mcp/events": "workspace:*",
    "@indodax-mcp/indodax-account": "workspace:*",
    "@indodax-mcp/indodax-alerts": "workspace:*",
    "@indodax-mcp/indodax-audit": "workspace:*",
    "@indodax-mcp/indodax-auth": "workspace:*",
    "@indodax-mcp/indodax-backtest": "workspace:*",
    "@indodax-mcp/indodax-client": "workspace:*",
    "@indodax-mcp/indodax-deadman": "workspace:*",
    "@indodax-mcp/indodax-execution": "workspace:*",
    "@indodax-mcp/indodax-market": "workspace:*",
    "@indodax-mcp/indodax-orders": "workspace:*",
    "@indodax-mcp/indodax-paper": "workspace:*",
    "@indodax-mcp/indodax-portfolio": "workspace:*",
    "@indodax-mcp/indodax-reconciliation": "workspace:*",
    "@indodax-mcp/indodax-risk": "workspace:*",
    "@indodax-mcp/indodax-strategy": "workspace:*",
    "@indodax-mcp/indodax-trading": "workspace:*",
    "@indodax-mcp/indodax-websocket": "workspace:*",
    "@indodax-mcp/logging": "workspace:*",
    "@indodax-mcp/mcp-contracts": "workspace:*",
    "@indodax-mcp/mcp-core": "workspace:*",
    "@indodax-mcp/mcp-registry": "workspace:*",
    "@indodax-mcp/observability": "workspace:*",
    "@indodax-mcp/scheduler": "workspace:*",
    "@indodax-mcp/transport": "workspace:*",
    "decimal.js": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@indodax-mcp/mcp-testing": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "bun-types": "catalog:",
    "vitest": "catalog:"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist/"
  ]
}
