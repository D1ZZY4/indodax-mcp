{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "dev:mcp": {
      "cache": false,
      "persistent": true
    },
    "dev:http": {
      "cache": false,
      "persistent": true
    },
    "dev:daemon": {
      "cache": false,
      "persistent": true
    },
    "dev:workbench": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "INDODAX_API_KEY",
        "INDODAX_API_SECRET",
        "APP_ENV",
        "TRADE_ENABLED",
        "WITHDRAW_ENABLED",
        "DATABASE_URL",
        "MCP_PORT",
        "MCP_HOST",
        "STOP_AUTOPOLL_MS",
        "ALERT_AUTOPOLL_MS"
      ]
    },
    "lint": {},
    "format": {
      "cache": false
    },
    "format:check": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["build"],
      "env": ["DATABASE_URL"]
    },
    "test:coverage": {
      "dependsOn": ["build"],
      "env": ["DATABASE_URL"]
    },
    "e2e": {
      "dependsOn": ["build"],
      "cache": false
    },
    "check": {
      "dependsOn": ["format:check", "lint", "typecheck", "test"]
    },
    "verify": {
      "dependsOn": ["build", "test", "e2e"]
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    }
  }
}
