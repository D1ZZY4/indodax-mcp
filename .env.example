# Indodax MCP
# Copy this file to .env and fill in your credentials

# Required for Private API (Account, Trading, Funding)
INDODAX_API_KEY=your_api_key_here
INDODAX_API_SECRET=your_api_secret_here

# Optional: Custom Rate Limit (Requests per second) - Default: 7
# INDODAX_RATE_LIMIT=5

# Optional: Custom WebSocket Token (Fallback to stable default if not set)
# INDODAX_WS_TOKEN=your_ws_token_here

# Optional: PostgreSQL for persistent storage (defaults to local dev database)
# DATABASE_URL=postgresql://indodax:indodax@127.0.0.1:5432/indodax

# Optional: MCP HTTP port (default 8000)
# MCP_PORT=8000

# Optional: MCP HTTP bind address (default 127.0.0.1 for a private host run).
# Containers must use 0.0.0.0, otherwise the published host port cannot reach
# the gateway process inside the container.
# MCP_HOST=127.0.0.1

# Optional: Runtime mode paper (default), development, or live (explicit opt-in)
# APP_ENV=paper

# Required for live order placement and cancellation. Paper ignores it.
# Withdrawals stay denied regardless of this flag.
# TRADE_ENABLED=true
# WITHDRAW_ENABLED=false

# Optional: evaluate server-side stops on an interval (ms). Unset by
# default, which keeps trigger checks fully manual for supervision.
# STOP_AUTOPOLL_MS=60000

# Optional: evaluate price alerts on an interval (ms). Unset by default,
# which keeps alert checks fully manual. Triggered alerts also push an
# MCP notifications/message to connected clients that listen.
# ALERT_AUTOPOLL_MS=30000

# Optional: enable the Jev advisory on indodax_strategy_evaluate. Uses only the
# free jev-1.13-free model. Advisory only: it cannot gate, alter, or authorise
# an order, and the tool behaves identically when this is unset.
# OPENCODE_API_KEY=
