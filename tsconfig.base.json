      "@indodax-mcp/indodax-mcp": ["./packages/indodax-mcp/src/index.ts"],
      "@indodax-mcp/indodax-mcp/*": ["./packages/indodax-mcp/src/*"],
      "@indodax-mcp/indodax-orders": ["./packages/indodax-orders/src/index.ts"],
      "@indodax-mcp/indodax-orders/*": ["./packages/indodax-orders/src/*"],
