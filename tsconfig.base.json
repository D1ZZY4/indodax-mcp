      "@indodax-mcp/mcp-http": ["./apps/mcp-http/src/index.ts"],
      "@indodax-mcp/mcp-http/*": ["./apps/mcp-http/src/*"],
      "@d1zzy4-jethools/indodax-mcp": ["./apps/mcp-stdio/src/index.ts"],
      "@d1zzy4-jethools/indodax-mcp/*": ["./apps/mcp-stdio/src/*"],
      "@indodax-mcp/mcp-workbench": ["./apps/mcp-workbench/src/index.ts"],
      "@indodax-mcp/mcp-workbench/*": ["./apps/mcp-workbench/src/*"]
    },
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
