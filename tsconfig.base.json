      "@indodax-mcp/logging": ["./packages/logging/src/index.ts"],
      "@indodax-mcp/logging/*": ["./packages/logging/src/*"],
      "@indodax-mcp/mcp-contracts": ["./packages/mcp-contracts/src/index.ts"],
      "@indodax-mcp/mcp-contracts/*": ["./packages/mcp-contracts/src/*"],
      "@indodax-mcp/mcp-core": ["./packages/mcp-core/src/index.ts"],
      "@indodax-mcp/mcp-core/*": ["./packages/mcp-core/src/*"],
      "@indodax-mcp/mcp-registry": ["./packages/mcp-registry/src/index.ts"],
      "@indodax-mcp/mcp-registry/*": ["./packages/mcp-registry/src/*"],
      "@indodax-mcp/mcp-runtime": ["./packages/mcp-runtime/src/index.ts"],
      "@indodax-mcp/mcp-runtime/*": ["./packages/mcp-runtime/src/*"],
      "@indodax-mcp/mcp-testing": ["./packages/mcp-testing/src/index.ts"],
      "@indodax-mcp/mcp-testing/*": ["./packages/mcp-testing/src/*"],
      "@indodax-mcp/observability": ["./packages/observability/src/index.ts"],
      "@indodax-mcp/observability/*": ["./packages/observability/src/*"],
      "@indodax-mcp/scheduler": ["./packages/scheduler/src/index.ts"],
      "@indodax-mcp/scheduler/*": ["./packages/scheduler/src/*"],
      "@indodax-mcp/secrets": ["./packages/secrets/src/index.ts"],
      "@indodax-mcp/secrets/*": ["./packages/secrets/src/*"],
      "@indodax-mcp/storage": ["./packages/storage/src/index.ts"],
      "@indodax-mcp/storage/*": ["./packages/storage/src/*"],
      "@indodax-mcp/transport": ["./packages/transport/src/index.ts"],
      "@indodax-mcp/transport/*": ["./packages/transport/src/*"],
      "@d1zzy4-jethools/indodax-mcp-cli": ["./apps/cli/src/index.ts"],
