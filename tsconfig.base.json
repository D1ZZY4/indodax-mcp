      "@indodax-mcp/indodax-strategy": ["./packages/indodax-strategy/src/index.ts"],
      "@indodax-mcp/indodax-strategy/*": ["./packages/indodax-strategy/src/*"],
      "@indodax-mcp/indodax-trading": ["./packages/indodax-trading/src/index.ts"],
