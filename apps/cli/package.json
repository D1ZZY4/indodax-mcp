{
  "name": "@d1zzy4-jethools/indodax-mcp-cli",
  "version": "1.1.1",
  "type": "module",
  "scripts": {
    "build": "bun build ./src/main.ts --outfile ./dist/index.js --target bun --banner '#!/usr/bin/env bun' && bun ../../scripts/sanitize-bundle.ts ./dist/index.js && chmod +x ./dist/index.js",
    "dev": "bun --watch ./src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "biome lint .",
    "format:check": "biome format .",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@d1zzy4-jethools/config": "workspace:*",
    "@d1zzy4-jethools/indodax-market": "workspace:*",
    "@d1zzy4-jethools/mcp-app": "workspace:*",
    "@d1zzy4-jethools/logging": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "bun-types": "catalog:",
    "citty": "catalog:",
    "vitest": "catalog:"
  },
  "description": "Command line companion to the indodax-mcp server: market reads, paper state, and risk limits",
  "keywords": [
    "indodax",
    "trading",
    "crypto",
    "cli",
    "paper-trading",
    "risk-management"
  ],
  "homepage": "https://github.com/D1ZZY4/indodax-mcp/tree/main/apps/cli#readme",
  "bugs": {
    "url": "https://github.com/D1ZZY4/indodax-mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/D1ZZY4/indodax-mcp.git",
    "directory": "apps/cli"
  },
  "license": "SSPL-1.0",
  "author": "D1ZZY4",
  "bin": {
    "indodax": "./dist/index.js"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  }
}
