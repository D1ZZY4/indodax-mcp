{
  "name": "@indodax-mcp/mcp-http",
  "version": "1.1.1",
  "type": "module",
  "bin": {
    "indodax-mcp-http": "./dist/index.js"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "scripts": {
    "build": "bun build ./src/main.ts --outfile ./dist/index.js --target bun --banner '#!/usr/bin/env bun' && bun ../../scripts/sanitize-bundle.ts ./dist/index.js && chmod +x ./dist/index.js",
    "dev": "bun --watch ./src/main.ts",
    "start": "bun ./src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "biome lint .",
    "format:check": "biome format .",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@indodax-mcp/config": "workspace:*",
    "@indodax-mcp/mcp-app": "workspace:*",
    "@indodax-mcp/logging": "workspace:*",
    "@indodax-mcp/mcp-runtime": "workspace:*"
  },
  "devDependencies": {
    "@indodax-mcp/mcp-testing": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "bun-types": "catalog:",
    "vitest": "catalog:"
  },
  "description": "Streamable HTTP gateway serving the INDODAX MCP server.",
  "keywords": [
    "indodax",
    "indodax-mcp",
    "mcp",
    "model-context-protocol",
    "trading",
    "crypto"
  ],
  "homepage": "https://github.com/D1ZZY4/indodax-mcp#readme",
  "bugs": {
    "url": "https://github.com/D1ZZY4/indodax-mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/D1ZZY4/indodax-mcp.git"
  },
  "license": "SSPL-1.0",
  "author": "D1ZZY4",
  "engines": {
    "bun": ">=1.4.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
