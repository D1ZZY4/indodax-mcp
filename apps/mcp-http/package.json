{
  "name": "@d1zzy4-jethools/mcp-http",
  "version": "1.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build ./src/main.ts --outfile ./dist/index.js --target bun && bun ../../scripts/sanitize-bundle.ts ./dist/index.js",
    "dev": "bun --watch ./src/main.ts",
    "start": "bun ./src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "biome lint .",
    "format:check": "biome format .",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@d1zzy4-jethools/config": "workspace:*",
    "@d1zzy4-jethools/mcp-app": "workspace:*",
    "@d1zzy4-jethools/logging": "workspace:*",
    "@d1zzy4-jethools/mcp-runtime": "workspace:*"
  },
  "devDependencies": {
    "@d1zzy4-jethools/mcp-testing": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "bun-types": "catalog:",
    "vitest": "catalog:"
  }
}
