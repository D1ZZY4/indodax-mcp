{
  "name": "@indodax-mcp/daemon",
  "version": "1.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build ./src/main.ts --outfile ./dist/index.js --target bun && bun ../../scripts/sanitize-bundle.ts ./dist/index.js",
    "dev": "bun --watch ./src/main.ts",
    "start": "bun ./src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "biome lint .",
    "format:check": "biome format .",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@indodax-mcp/config": "workspace:*",
    "@indodax-mcp/core": "workspace:*",
    "@indodax-mcp/indodax-market": "workspace:*",
    "@indodax-mcp/indodax-mcp": "workspace:*",
    "@indodax-mcp/logging": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "bun-types": "catalog:",
    "vitest": "catalog:"
  }
}
