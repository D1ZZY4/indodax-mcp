{
  "name": "@indodax-mcp/indodax-mcp",
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "build": "bun build ./src/main.ts --outfile ./dist/index.js --target bun --banner '#!/usr/bin/env bun' && bun ../../scripts/sanitize-bundle.ts ./dist/index.js && chmod +x ./dist/index.js",
    "dev:mcp": "bun --watch ./src/main.ts",
    "start": "bun ./src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "biome lint .",
    "format:check": "biome format .",
    "test:coverage": "vitest run --coverage",
    "prepack": "rm -rf ./docs-tools && cp -r ../../docs/tools ./docs-tools"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@indodax-mcp/config": "workspace:*",
    "@indodax-mcp/errors": "workspace:*",
    "@indodax-mcp/mcp-app": "workspace:*",
    "@indodax-mcp/logging": "workspace:*",
    "@indodax-mcp/mcp-contracts": "workspace:*",
    "@indodax-mcp/mcp-core": "workspace:*",
    "@indodax-mcp/mcp-registry": "workspace:*",
    "@indodax-mcp/mcp-runtime": "workspace:*",
    "@indodax-mcp/mcp-testing": "workspace:*",
    "@modelcontextprotocol/client": "catalog:",
    "@modelcontextprotocol/server": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "description": "MCP server for INDODAX spot trading: market reads, paper execution, deterministic risk, emulated stops, and a gated live path",
  "keywords": [
    "mcp",
    "indodax-mcp",
    "model-context-protocol",
    "indodax",
    "trading",
    "crypto",
    "paper-trading",
    "risk-management",
    "llm"
  ],
  "homepage": "https://github.com/D1ZZY4/indodax-mcp#readme",
  "bugs": {
    "url": "https://github.com/D1ZZY4/indodax-mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/D1ZZY4/indodax-mcp.git"
  },
  "license": "SSPL-1.0",
  "author": "D1ZZY4",
  "bin": {
    "indodax-mcp": "./dist/index.js"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "files": [
    "dist/",
    "docs-tools/",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  }
}
