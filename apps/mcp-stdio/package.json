{
  "name": "indodax-mcp",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "bun build ./src/main.ts --outfile ./dist/index.js --target bun --banner '#!/usr/bin/env bun' && chmod +x ./dist/index.js",
    "dev:mcp": "bun --watch ./src/main.ts",
    "start": "bun ./src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "biome lint .",
    "format:check": "biome format .",
    "test:coverage": "vitest run --coverage",
    "prepack": "rm -rf ./docs-tools && cp -r ../../docs/tools ./docs-tools"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@indodax-mcp/config": "workspace:*",
    "@indodax-mcp/errors": "workspace:*",
    "@indodax-mcp/indodax-mcp": "workspace:*",
    "@indodax-mcp/logging": "workspace:*",
    "@indodax-mcp/mcp-contracts": "workspace:*",
    "@indodax-mcp/mcp-core": "workspace:*",
    "@indodax-mcp/mcp-registry": "workspace:*",
    "@indodax-mcp/mcp-runtime": "workspace:*",
    "@indodax-mcp/mcp-testing": "workspace:*",
    "@modelcontextprotocol/client": "catalog:",
    "@modelcontextprotocol/server": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "description": "INDODAX MCP server over stdio and Streamable HTTP",
  "license": "SSPL-1.0",
  "bin": {
    "indodax-mcp": "./dist/index.js"
  },
  "files": [
    "dist/",
    "docs-tools/"
  ],
  "publishConfig": {
    "access": "public"
  }
}
